# This is a good default: files that are auto-detected by git to be text are
# converted to the platform-native line ending (LF on Unix, CRLF on Windows)
# in the working tree and to LF in the repository.
#
* text=auto

# Use `eol=crlf` for files that should have the CRLF line ending both in the
# working tree (even on Unix) and in the repository.
#
#*.bat text eol=crlf

# Use `eol=lf` for files that should have the LF line ending both in the
# working tree (even on Windows) and in the repository.
#
#*.sh text eol=lf

# Use `binary` to make sure certain files are never auto-detected as text.
#
#*.png binary

# Mark the generated files that we commit (see pregenerated/ in the package
# buildfiles) so that they are excluded from the repository's language
# statistics and collapsed in diffs.
#
**/pregenerated/** linguist-generated

# The ODB changelog is rewritten by the ODB compiler, so it cannot carry the
# SPDX header (see libobe/libobe/model.hxx).
#
libobe/libobe/model.xml -spdx linguist-generated

# The documentation style sheets come from the build2 style repository with
# their own license notice (see obe/LEGAL).
#
obe/doc/style/** -spdx

# The pregenerated code is overwritten by the ODB and CLI compilers in the
# development build and the checksums of its sources are compared with the
# sha256sum output as is (see the pregenerated-current tests), so they cannot
# carry the SPDX header.
#
**/pregenerated/** -spdx

# The publisher files are served to the clients byte for byte (the IW4x
# playlists, for example, have CRLF line endings and Windows-1252 names), so
# they are neither normalized nor given the SPDX header.
#
obe/data/publisher/** -text -spdx

# The test certificates and keys are PEM data, which has no comment syntax.
#
libobe/tests/**/*.pem -spdx

# The identity register (see mailmap and authors in the IW4x toolchain) and
# the clangd configuration are data files without a header.
#
identities -spdx
.clangd -spdx
