# The compilation database is generated by build2 into the repository root
# (see config.cc.compiledb in README.md).
#
CompileFlags:
  CompilationDatabase: .

---

# The inline (.ixx) and template (.txx) definitions are included at the end
# of their headers. Parse them as C++ headers.
#
If:
  PathMatch: .*\.(ixx|txx)

CompileFlags:
  Add: [-xc++-header]
