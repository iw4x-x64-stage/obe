: messaging
:
{{
  test.arguments += messaging

  : send
  : Test pushing a message to the connected recipients
  :
  $* <<EOI >>EOO
  task 2 2 1

  task 2 3 1

  task 1 1 8
  uint8 0
  blob 0161
  uint32 1
  bool true
  uint64 2

  task 1 1 8
  uint8 0
  blob 02
  uint32 1
  bool false
  uint64 3
  EOI
  error 108: messaging operation 1 not supported
  error 108: messaging operation 1 not supported
  push 2
    uint32 40
    uint64 2
    uint64 1
    uint32 1
    bool false
    uint64 1
    string user-1
    blob 0161
  push 3
    uint32 40
    uint64 2
    uint64 1
    uint32 1
    bool false
    uint64 1
    string user-1
    blob 0161
  ok
  ok
  EOO

  : invalid
  : Test invalid requests
  :
  $* <<EOI >>EOO
  task 1 1 8
  uint8 0
  blob 00
  uint32 1
  bool false
  uint64 2
  uint64 3
  uint64 4

  task 1 1 8
  uint8 0
  blob 00
  uint32 1
  bool false
  EOI
  error 1301: more than 2 recipients
  error 106: no recipients
  EOO
}}

: memory
: Test the services with the stores in memory
:
{{
  .include store.testscript
}}

: pgsql
: Test the services with the stores in the PostgreSQL database (see
: config.libobe.test.pgsql)
:
if ($pgsql != [null])
{{
  test.options += --pgsql $pgsql

  .include store.testscript
}}
