: upload
: Test the upload, counting the bytes after the first packet
:
$* <<EOI >>EOO
request 1 0
upload 1 0 1 2 3
finalize 1
finalize 1
EOI
accepted 127.0.0.1
results 120 1 0 3
rejected 1812
EOO

: upload-loss
: Test the upload with lost and reordered packets
:
$* <<EOI >>EOO
request 1 0
upload 1 2 0
finalize 1
EOI
accepted 127.0.0.1
results 40 1 0 2
EOO

: upload-none
: Test the upload that didn't get through
:
$* <<EOI >>EOO
request 1 0
upload 1 3
finalize 1
EOI
accepted 127.0.0.1
rejected 1813
EOO

: upload-range
: Test the upload ignoring the packets out of the sequence range
:
$* <<EOI >>EOO
request 1 0
upload 1 4 0 1
finalize 1
EOI
accepted 127.0.0.1
results 40 0 0 1
EOO

: download
: Test the upload and download
:
{{
  : complete
  :
  $* <<EOI >>EOO
  request 1 1
  upload 1 0 1 2 3
  download 1
  finalize 1
  EOI
  accepted 127.0.0.1
  received 0 1 2 3
  results 120 1 0 3
  EOO

  : loss
  :
  $* <<EOI >>EOO
  request 1 1
  upload 1 0 1
  download 1
  finalize 1
  EOI
  accepted 127.0.0.1
  received 0 1 2 3
  results 40 0 0 1
  EOO
}}

: replace
: Test that a new request replaces the connection's test
:
$* <<EOI >>EOO
request 1 0
upload 1 0 1
request 1 0
finalize 1
EOI
accepted 127.0.0.1
accepted 127.0.0.1
rejected 1813
EOO

: connections
: Test the tests of several connections and their limit
:
$* --max-tests 1 <<EOI >>EOO
request 1 0
request 2 0
disconnect 1
request 2 0
upload 2 0 1 2 3
finalize 1
finalize 2
EOI
accepted 127.0.0.1
rejected 1810
accepted 127.0.0.1
rejected 1812
results 120 1 0 3
EOO

: address
: Test the address offered to the client
:
{{
  : mapped
  :
  $* <<EOI >>EOO
  request 1 0 ::ffff:127.0.0.1
  EOI
  accepted 127.0.0.1
  EOO

  : ipv6
  :
  $* <<EOI >>EOO 2>>EOE
  request 1 0 ::1
  EOI
  rejected 1810
  EOO
  warning: no IPv4 address to offer bandwidth test to connection 1
  EOE

  : public
  :
  $* --public-address 192.0.2.1 --public-port 3075 <<EOI >>EOO
  request 1 0 ::1
  EOI
  accepted 192.0.2.1
  EOO
}}

: invalid
: Test the invalid requests
:
$* <<EOI >>EOO
task 1 02
task 1 00
task 1 0002
task 1 01
EOI
error 106: invalid bandwidth test request 2
error 106: missing bandwidth test type
error 106: invalid bandwidth test type 2
error 106: missing bandwidth test download results
EOO
