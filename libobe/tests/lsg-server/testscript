: encrypted
: Test the handshake and the task replies over an encrypted connection
:
$* encrypted >>EOO 2>>~%EOE%
encrypted connection id 1
encrypted task reply tx 1 error 0 op 1 value 42
encrypted task reply tx 2 error 101
encrypted task reply tx 3 error 108
encrypted task reply tx 4 error 106
encrypted service reply tx 5 data 3 2 1
disconnect 1
EOO
%.+: info: user 3 connected as 1%
%.+: warning: task 2 failed: operation 2 denied \(access denied\)%
%.+: warning: task 3 failed: unknown service 99 \(service not available\)%
%.+: warning: task 4 failed: expected uint32 instead of string%
EOE

: plain
: Test a connection without encryption
:
$* plain >>EOO 2>>~%EOE%
plain connection id 1
plain task reply tx 1 error 0 op 1 value 42
disconnect 1
EOO
%.+: info: user 3 connected as 1%
EOE

: reset
: Test a connection reset by the client
:
$* reset >>EOO 2>>~%EOE%
encrypted connection id 1
disconnect 1
EOO
%.+: info: user 3 connected as 1%
EOE

: empty
: Test the protocol violation of an empty task frame
:
$* empty >>EOO 2>>~%EOE%
plain connection id 1
disconnect 1
closed
EOO
%.+: info: user 3 connected as 1%
%.+: warning: empty task frame%
EOE

: push
: Test pushing messages to the client
:
{{
  : deliver
  :
  $* push >>EOO 2>>~%EOE%
  encrypted connection id 1
  encrypted push value 7
  encrypted task reply tx 1 error 0 op 1 value 1
  disconnect 1
  EOO
  %.+: info: user 3 connected as 1%
  EOE

  : oversized
  :
  $* oversized >>EOO 2>>~%EOE%
  encrypted connection id 1
  encrypted task reply tx 1 error 0 op 2 value 0
  disconnect 1
  EOO
  %.+: info: user 3 connected as 1%
  %.+: warning: push message of 65536 bytes exceeds client capacity%
  EOE

  : full
  :
  $* full >>EOO 2>>~%EOE%
  encrypted connection id 1
  encrypted push value 7
  encrypted push value 7
  encrypted push value 7
  encrypted task reply tx 1 error 0 op 1 value 3
  disconnect 1
  EOO
  %.+: info: user 3 connected as 1%
  %.+: warning: send queue full, push dropped%
  EOE
}}

: handshake
: Test the handshake failures
:
{{
  : expired
  :
  $* expired >>EOO 2>>~%EOE%
  plain error 101
  closed
  EOO
  %.+: warning: handshake failed: server ticket expired \(access denied\)%
  EOE

  : title
  :
  $* title >>EOO 2>>~%EOE%
  plain error 101
  closed
  EOO
  %.+: warning: handshake failed: server ticket is for title 1234 instead of 4321 \(access denied\)%
  EOE

  : forged
  :
  $* forged >>EOO 2>>~%EOE%
  plain error 101
  closed
  EOO
  %.+: warning: handshake failed: server ticket authentication failed \(access denied\)%
  EOE

  : service
  :
  $* service >>EOO 2>>~%EOE%
  plain error 113
  closed
  EOO
  %.+: warning: handshake failed: invalid handshake frame \(protocol error\)%
  EOE

  : untyped
  :
  $* untyped >>EOO 2>>~%EOE%
  plain error 113
  closed
  EOO
  %.+: warning: handshake failed: untyped handshake buffer \(protocol error\)%
  EOE

  : truncated
  :
  $* truncated >>EOO 2>>~%EOE%
  plain error 113
  closed
  EOO
  %.+: warning: handshake failed: invalid handshake: expected uint32 instead of no type \(protocol error\)%
  EOE

  : version
  :
  $* version >>EOO 2>>~%EOE%
  closed
  EOO
  %.+: warning: invalid prelude: unsupported protocol version 179%
  EOE
}}

: idle
