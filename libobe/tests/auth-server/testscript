test.options += $src_base/cert.pem $src_base/key.pem

: grant
:
$* <<EOI >>EOO 2>>~%EOE%
POST /auth/ user:42:player {"auth_task":44,"iv_seed":5,"title_id":1234}
EOI
200 code 700 iv 5 user 42 name player title 1234 server-user 42 key match RETAIL PC
EOO
%.+: info: authenticated user 42 \(player\) for title 1234%
EOE

: deny
: Test the application-level failures
:
$* <<EOI >>EOO 2>>~%EOE%
POST /auth/ deny {"auth_task":44,"iv_seed":5,"title_id":1234}
POST /auth/ fail {"auth_task":44,"iv_seed":5,"title_id":1234}
POST /auth/ user:1:a {"auth_task":44,"iv_seed":5,"title_id":4321}
POST /auth/ user:1:a {"auth_task":45}
EOI
200 code 704
200 code 702
200 code 703
200 code 701
EOO
%.+: warning: authentication denied%
%.+: error: unable to authenticate: platform unavailable%
%.+: warning: title 4321 not served%
%.+: warning: invalid auth request: auth task 45 instead of 44%
EOE

: http
: Test the HTTP-level failures
:
$* <<EOI >>EOO 2>>~%EOE%
GET /auth/ user:1:a
POST /other/ user:1:a {}
POST /auth/ *9000 {}
POST /auth/ user:1:a *9000
EOI
405
404
431
413
EOO
%.+: warning: request too large%{2}
EOE
