  : number
  : Test a number written as a string
  :
  $* <'reply {"auth_task":45,"code":"735"}' 2>>EOE != 0
  error: invalid auth reply: invalid 'code' member value
  EOE

  : range
  : Test a number beyond the signed 64-bit range, which JSON parses as
  : unsigned
  :
  $* <<EOI 2>>EOE != 0
  reply {"auth_task":45,"code":700,"iv_seed":18446744073709551615}
  EOI
  error: invalid auth reply: invalid 'iv_seed' member value
  EOE

  : string
  :
  $* <<EOI 2>>EOE != 0
  reply {"auth_task":45,"code":700,"iv_seed":5,"client_ticket":1}
  EOI
  error: invalid auth reply: 'client_ticket' member is not a string
  EOE
}}

: base64
:
{{
  : valid
  :
  $* <<EOI >>EOO
  encode 
  encode 61
  encode 6162
  encode 616263
  decode YQ==
  decode YWI=
  decode YWJj
  EOI

  YQ==
  YWI=
  YWJj
  61
  6162
  616263
  EOO

  : invalid
  :
  {{
    $* <'decode YWJ' 2>'error: invalid base64 length' != 0       : length
    $* <'decode Y=Jj' 2>'error: invalid base64 character' != 0    : padding
    $* <'decode YW J' 2>'error: invalid base64 character' != 0    : space
  }}
}}

: base64url
:
{{
  : valid
  :
  $* <<EOI >>EOO
  encode-url 
  encode-url 61
  encode-url 6162
  encode-url 616263
  encode-url fbff
  decode-url YQ
  decode-url YWI
  decode-url YWJj
  decode-url -_8
  EOI

  YQ
  YWI
  YWJj
  -_8
  61
  6162
  616263
  fbff
  EOO

  : invalid
  :
  {{
    $* <'decode-url YWJjZ' 2>'error: invalid base64url length' != 0  : length
    $* <'decode-url YQ==' 2>'error: invalid base64url character' != 0 : padding
    $* <'decode-url -/8' 2>'error: invalid base64url character' != 0  : slash
    $* <'decode-url YW J' 2>'error: invalid base64 character' != 0    : space
  }}
}}
