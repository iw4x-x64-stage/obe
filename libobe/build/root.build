# Development mode: regenerate the database support code from the persistent
# classes with the ODB compiler. The consumption build uses the pregenerated
# code and doesn't need the ODB compiler (see libobe/buildfile for details).
#
config [bool] config.libobe.develop ?= false

develop = $config.libobe.develop

# Suppress warnings coming from external libraries.
#
cxx.internal.scope = current

cxx.std = latest

using cxx

hxx{*}: extension = hxx
ixx{*}: extension = ixx
txx{*}: extension = txx
cxx{*}: extension = cxx

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
