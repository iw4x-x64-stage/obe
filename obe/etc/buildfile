./: file{** -buildfile}

# Install into the etc/ subdirectory of, say, /usr/share/ recreating
# subdirectories.
#
*:
{
  install         = data/etc/
  install.subdirs = true
}

# Keep the executable permission for the installed script files.
#
private/postgresql/
{
  file{obe-postgresql-setup}@./: install.mode=755
}
